#ifndef LIGHTING_HEADER
#define LIGHTING_HEADER

#include "noise"

float calculateAnisotropicBias(ivec2 texSize, vec3 viewSpacePos, float minBias, float maxBias) {
    const vec3 dpdx = dFdx(viewSpacePos);
	const vec3 dpdy = dFdy(viewSpacePos);

	const vec2 dz_duv = vec2(
    	dpdx.z * texSize.x, 
    	dpdy.z * texSize.y
	);

	const float slopeBias = clamp(max(abs(dz_duv.x), abs(dz_duv.y)), 0.0f, maxBias);
	return minBias + slopeBias;
}

float textureProj(in sampler2DArrayShadow shadowTex, vec4 shadowCoord, vec2 offset, uint cascadeIndex, float bias) {
	if (shadowCoord.z > 0.0f && shadowCoord.z < 1.0f) {
		const float dist = texture(shadowTex, vec4(shadowCoord.xy + offset, cascadeIndex, shadowCoord.z - bias));
		return dist * step(0.0f, shadowCoord.w);
	}
	return 1.0f;
}

float textureProj2(in sampler2DArray shadowTex, vec4 shadowCoord, vec2 offset, uint cascadeIndex, float bias) {
	if (shadowCoord.z > 0.0f && shadowCoord.z < 1.0f) {
		const vec2 uv = shadowCoord.xy + offset;
		const float dist = texture(shadowTex, vec3(uv, cascadeIndex)).r;
		if (dist > shadowCoord.z - bias) {
			return step(0.0f, shadowCoord.w);
		}
	}
	return 1.0f;
}

float filterPCF(in sampler2DArray shadowTex, vec4 sc, uint cascadeIndex, float bias) {
	const ivec2 texDim = textureSize(shadowTex, 0).xy;
	const float scale = 0.6f;
	const float dx = scale * 1.0f / float(texDim.x);
	const float dy = scale * 1.0f / float(texDim.y);

	float shadowFactor = 1.0f;
	int count = 0;
	const int range = 1;
	
	for (int x = -range; x <= range; ++x) {
		for (int y = -range; y <= range; ++y) {
			shadowFactor += textureProj2(shadowTex, sc, vec2(dx*x, dy*y), cascadeIndex, bias);
			count++;
		}
	}
	return shadowFactor / count;
}


// use hardware assisted PCF + 3x3 gaussian filter
float filterPCF_Low(
	in sampler2DArrayShadow map,
	ivec2 texSize,
	vec3 shadowPosition,
    uint layer,
    float bias
) {
	if (shadowPosition.z <= 0.0f || shadowPosition.z >= 1.0f) {
		return 1.0f;
	}
	
    const vec2 size = texSize;
    const vec2 texelSize = 1.0f / size;

    // note: shadowPosition.z is in the [1, 0] range (reversed Z)
    // shadowPosition.z = clamp(shadowPosition.z, 0.0f, 1.0f);
    // Castaño, 2013, "Shadow Mapping Summary Part 1"
    shadowPosition.xy = clamp(shadowPosition.xy, vec2(-1.0f), vec2(2.0f));

    const vec2 offset = vec2(0.5f);
    const vec2 uv = (shadowPosition.xy * size) + offset;
    const vec2 base = (floor(uv) - offset) * texelSize;
    const vec2 st = fract(uv);
    const vec2 uw = vec2(3.0f - 2.0f * st.x, 1.0f + 2.0f * st.x);
    const vec2 vw = vec2(3.0f - 2.0f * st.y, 1.0f + 2.0f * st.y);
    const vec2 u = vec2((2.0f - st.x) / uw.x - 1.0f, st.x / uw.y + 1.0f) * texelSize.x;
    const vec2 v = vec2((2.0f - st.y) / vw.x - 1.0f, st.y / vw.y + 1.0f) * texelSize.y;

    const float w0 = uw.x * vw.x;
    const float w1 = uw.y * vw.x;
    const float w2 = uw.x * vw.y;
    const float w3 = uw.y * vw.y;
    const vec2 uv0 = base + vec2(u.x, v.x);
    const vec2 uv1 = base + vec2(u.y, v.x);
    const vec2 uv2 = base + vec2(u.x, v.y);
    const vec2 uv3 = base + vec2(u.y, v.y);

    float sum = 0.0f;
    const float depth = shadowPosition.z - bias;
    sum += w0 * texture(map, vec4(uv0, layer, depth));
    sum += w1 * texture(map, vec4(uv1, layer, depth));
    sum += w2 * texture(map, vec4(uv2, layer, depth));
    sum += w3 * texture(map, vec4(uv3, layer, depth));
    return sum * 0.0625f;
}

float filterPCF_Low2(
	in sampler2DArrayShadow map,
	ivec2 texSize,
	vec3 shadowPosition,
    uint layer,
    float bias,
    float force,
    int steps
) {
	// Poisson disk point set
	const vec2 poissonDisk[16] = vec2[](
	    vec2(-0.94201624, -0.39906216),
	    vec2(0.94558609, -0.76890725),
	    vec2(-0.09418410, -0.92938870),
	    vec2(0.34495938, 0.29387760),
	    vec2(-0.91588581, 0.45771432),
	    vec2(-0.81544232, -0.87922460),
	    vec2(-0.38277543, 0.27676845),
	    vec2(0.97484398, 0.75648379),
	    vec2(0.44323325, -0.97511554),
	    vec2(0.53742981, -0.47373420),
	    vec2(-0.26496911, -0.41893023),
	    vec2(0.79197514, 0.19090188),
	    vec2(-0.24188840, 0.99706507),
	    vec2(-0.81409955, 0.09143855),
	    vec2(0.19984126, 0.78641367),
	    vec2(0.14383161, -0.14100790)
	);

    const float texelSize = 1.0f / texSize.x / float(layer + 1.0f);
    const float filterRadius = texelSize * force; // blur radius

    const float angle = random(gl_FragCoord.xy) * 6.28318530718;
    const float s = sin(angle);
    const float c = cos(angle);
    const mat2 rotationMatrix = mat2(c, -s, s, c);

    float shadowFactor = 0.0;
    for (int i = 0; i < steps; i++) {
        const vec2 offset = (rotationMatrix * poissonDisk[i]) * filterRadius;
        shadowFactor += texture(map, vec4(shadowPosition.xy + offset, layer, shadowPosition.z - bias));
    }
    return shadowFactor / float(steps);
}

#endif