#ifndef PBR_HEADER
#define PBR_HEADER

const float PI = 3.14159265359f;
// Trowbridge-Reitz GGX Normal Distribution Function
float distributionGGX(float dotNH, float roughness) {
    const float a = roughness * roughness;
    const float a2 = a * a;
    const float dotNH2 = dotNH * dotNH;
    
    const float num = a2;
    float denom = (dotNH2 * (a2 - 1.0f) + 1.0f);
    denom = PI * denom * denom;
    
    return num / denom;
}

// Schlick-GGX Geometry Function
float geometrySmith(float dotNV, float dotNL, float roughness) {
    const float r = (roughness + 1.0f);
    const float k = (r * r) / 8.0f; // Analytical lighting k
    const float ggx1 = dotNV / (dotNV * (1.0f - k) + k);
    const float ggx2 = dotNL / (dotNL * (1.0f - k) + k);
    
    return ggx1 * ggx2;
}

// Fresnel-Schlick Equation
vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0f - F0) * pow(1.0f - cosTheta, 5.0f);
}

#endif