#ifndef SKY_HEADER
#define SKY_HEADER

struct SkyColors {
    vec3 skyColor;
    vec3 sunColor;
};

vec3 sampleSkyColorByRadians(vec3 nightColor, vec3 sunsetColor, vec3 dayColor, float angle) {
    if (angle < 0.0f) {
        // the sun has set. transition from night (-0.21 rad) to sunset (0.0 rad)
        const float t = clamp((angle + 0.21f) / 0.21f, 0.0f, 1.0f);
        return mix(nightColor, sunsetColor, t);
    } else {
        // the sun is rising. transition from sunset (0.0 rad) to bright daylight (0.43 rad).
        const float t = clamp(angle / 0.43f, 0.0f, 1.0f);
        return mix(sunsetColor, dayColor, t);
    }
}

vec3 sampleSkyColorByRadians2(vec3 nightColor, vec3 sunsetColor, vec3 dayColor, float angle) {
    if (angle < 0.0f) {
        // transition: night (-0.21) -> sunset (0.0)
        float t = clamp((angle + 0.21f) / 0.21f, 0.0f, 1.0f);
        // add smoothness via smoothstep to remove sharp kink at zero
        t = smoothstep(0.0f, 1.0f, t); 
        return mix(nightColor, sunsetColor, t);
    } else {
        // transition: sunset (0.0) -> day (0.43)
        float t = clamp(angle / 0.43f, 0.0f, 1.0f);
        t = smoothstep(0.0f, 1.0f, t);
        
        // small trick: on early sunrise blend in some pink/purple
        // so blue sky and orange horizon don’t produce gray seam
        const vec3 edgeCorrection = vec3(0.4f, 0.15f, 0.3f) * smoothstep(1.0f, 0.0f, abs(t - 0.2f));
        return mix(sunsetColor, dayColor, t) + edgeCorrection * (1.0f - clamp(angle, 0.0f, 1.0f));
    }
}

vec3 sampleSkyColorByRadians3(vec3 nightColor, vec3 sunsetColor, vec3 dayColor, float angle) {
    const float tDay = smoothstep(0.0f, 0.35f, angle);
    const float tNight = smoothstep(0.0f, -0.20f, angle);
    const vec3 base = mix(sunsetColor, dayColor, tDay);
    return mix(base, nightColor, tNight);
}

SkyColors simpleSky(const vec3 viewDir, const vec3 sunViewDir, const vec3 sunWorldDir) {
    // palettes in linear space
    const vec3 dayTop       = vec3(0.05f, 0.21f, 0.53f);
    const vec3 dayBottom    = vec3(0.43f, 0.67f, 0.89f);
    const vec3 daySun       = vec3(1.5f, 1.4f, 1.2f);

    const vec3 sunsetTop    = vec3(0.02f, 0.05f, 0.15f);
    const vec3 sunsetBottom = vec3(0.95f, 0.35f, 0.05f);
    const vec3 sunsetSun    = vec3(2.0f, 0.8f, 0.2f);

    const vec3 nightTop     = vec3(0.002f, 0.004f, 0.01f);
    const vec3 nightBottom  = vec3(0.01f, 0.015f, 0.025f);
    const vec3 nightSun     = vec3(0.0f, 0.0f, 0.0f);

    const vec3 skyColorTop    = sampleSkyColorByRadians(nightTop, sunsetTop, dayTop, sunWorldDir.z);
    const vec3 skyColorBottom = sampleSkyColorByRadians(nightBottom, sunsetBottom, dayBottom, sunWorldDir.z);
    const vec3 sunColor       = sampleSkyColorByRadians(nightSun, sunsetSun, daySun, sunWorldDir.z);

    const float mixFactor = clamp(viewDir.y * 0.5f + 0.5f, 0.0f, 1.0f);
    const vec3 finalSkyColor = mix(skyColorBottom, skyColorTop, mixFactor);

    const float dotViewSun = dot(viewDir, sunViewDir);
    
    // solar disk and halo
    const float sunIntensity = smoothstep(0.9994f, 0.9998f, dotViewSun);
    const float sunGlow = pow(max(dotViewSun, 0.0f), 128.0f) * 0.5f;

    return SkyColors(
        finalSkyColor + (sunColor * sunIntensity) + (sunColor * sunGlow),
        sunColor);
}

SkyColors simpleSky2(const vec3 viewDir, const vec3 sunViewDir, const vec3 sunWorldDir) {
    // palettes in linear space
    const vec3 dayTop       = vec3(0.03f, 0.15f, 0.45f); // made slightly deeper
    const vec3 dayBottom    = vec3(0.38f, 0.63f, 0.87f);
    const vec3 daySun       = vec3(2.0f, 1.8f, 1.5f);    // made brighter (hdr)

    const vec3 sunsetTop    = vec3(0.01f, 0.03f, 0.12f);
    const vec3 sunsetBottom = vec3(0.98f, 0.32f, 0.02f); // more saturated orange
    const vec3 sunsetSun    = vec3(3.5f, 0.9f, 0.1f);    // strong sunset light

    const vec3 nightTop     = vec3(0.001f, 0.002f, 0.008f);
    const vec3 nightBottom  = vec3(0.005f, 0.008f, 0.018f);
    const vec3 nightSun     = vec3(0.0f, 0.0f, 0.0f);

    // base colors depending on sun height
    const vec3 skyColorTop    = sampleSkyColorByRadians2(nightTop, sunsetTop, dayTop, sunWorldDir.z);
    const vec3 skyColorBottom = sampleSkyColorByRadians2(nightBottom, sunsetBottom, dayBottom, sunWorldDir.z);
    const vec3 sunColor       = sampleSkyColorByRadians2(nightSun, sunsetSun, daySun, sunWorldDir.z);

    // nice improvement 1: exponential height gradient instead of linear
    // direction up (viewDir.y) now smoothly goes to zenith leaving haze near horizon
    const float skyHeight = max(viewDir.y, 0.0f);
    const float mixFactor = 1.0f - exp(-skyHeight * 2.15f); // 2.15 controls haze thickness near horizon
    const vec3 finalSkyColor = mix(skyColorBottom, skyColorTop, mixFactor);

    // dot product for sun
    const float dotViewSun = dot(viewDir, sunViewDir);
    
    // nice improvement 2: sun halo (simplified mie phase function)
    // gives nice cinematic light scattering in atmosphere
    const float g = 0.9995f; // anisotropy (closer to 1.0 makes narrower and brighter light beam)
    const float miePart1 = (1.0f - g * g);
    const float miePart2 = (1.0f + g * g - 2.0f * g * dotViewSun);
    const float sunGlow = 0.1f * miePart1 / (miePart2 * sqrt(miePart2));

    // nice improvement 3: dynamic halo size
    // at sunset air density makes sun halo wider and softer
    const float sunsetFactor = smoothstep(0.3f, -0.1f, sunWorldDir.z);
    float modifiedSunGlow = sunGlow * mix(1.0f, 3.5f, sunsetFactor); 

    // sun disk (slightly softer edge to avoid pixel staircases)
    const float sunIntensity = smoothstep(0.99985f, 0.99993f, dotViewSun) * 2.0f;

    // final assembly: sky + sun disk + atmospheric glow
    const vec3 finalColor = finalSkyColor + (sunColor * sunIntensity) + (sunColor * modifiedSunGlow);

    // nice improvement 4: fade out sun below horizon
    // if sun went deep below horizon completely remove its light from frame
    const float sunVisibility = smoothstep(-0.15f, 0.0f, sunWorldDir.z);
    const vec3 resultColor = mix(finalSkyColor, finalColor, sunVisibility);

    return SkyColors(resultColor, sunColor);
}

SkyColors simpleSky3(
    const vec3 viewDirView,   // view direction vector in view space (normalize(v_rayDirView))
    const vec3 sunDirView,    // sun direction vector in view space (normalize(L))
    const vec3 sunDirWorld,   // sun direction in world space (from u_shadow.viewInverse)
    const vec3 worldUpInView  // up vector mat3(push.view) * vec3(0, 0, 1)
) {
    // palettes (hdr)
    const vec3 dayTop       = vec3(0.02f, 0.12f, 0.42f); 
    const vec3 dayBottom    = vec3(0.42f, 0.65f, 0.88f);
    const vec3 daySun       = vec3(4.0f, 3.8f, 3.2f);

    const vec3 sunsetTop    = vec3(0.015f, 0.02f, 0.08f); 
    const vec3 sunsetBottom = vec3(0.98f, 0.35f, 0.02f);
    const vec3 sunsetSun    = vec3(5.0f, 1.2f, 0.05f);

    const vec3 nightTop     = vec3(0.0005f, 0.001f, 0.004f);
    const vec3 nightBottom  = vec3(0.002f, 0.004f, 0.012f);
    const vec3 nightSun     = vec3(0.0f);

    const float sunHeightWorld = sunDirWorld.z; 

    const vec3 skyColorTop    = sampleSkyColorByRadians3(nightTop, sunsetTop, dayTop, sunHeightWorld);
    const vec3 skyColorBottom = sampleSkyColorByRadians3(nightBottom, sunsetBottom, dayBottom, sunHeightWorld);
    const vec3 sunColor       = sampleSkyColorByRadians3(nightSun, sunsetSun, daySun, sunHeightWorld);

    // sky height: calculated using projection onto the true world’s top in view space
    // this ensures stable horizon when camera tilts
    const float skyHeight = max(dot(viewDirView, worldUpInView), 0.0f);
    const float mixFactor = 1.0f - exp(-skyHeight * 4.0f);
    const vec3 baseSkyColor = mix(skyColorBottom, skyColorTop, mixFactor);

    // ozone effect
    const float sunsetIntensity = smoothstep(0.2f, -0.1f, sunHeightWorld) * smoothstep(-0.3f, -0.1f, sunHeightWorld);
    vec3 modifiedBaseSkyColor = baseSkyColor + vec3(0.08f, 0.03f, 0.22f) * sunsetIntensity * mixFactor;

    // calculate angle strictly in view space
    // since both vectors are initial they are guaranteed to move at same speed
    const float dotViewSun = dot(viewDirView, sunDirView);

    // belt of venus
    const float oppositeSun = max(-dotViewSun, 0.0f); 
    const float beltOfVenusFactor = pow(oppositeSun, 2.0f) * smoothstep(0.0f, 0.2f, skyHeight) * smoothstep(0.3f, 0.0f, skyHeight);
    modifiedBaseSkyColor += vec3(0.85f, 0.25f, 0.35f) * beltOfVenusFactor * sunsetIntensity;

    // calculate deviation
    const float angleToSun = 1.0f - max(dotViewSun, 0.0f);

    // solar disk
    const float sunIntensity = smoothstep(0.99993f, 0.99996f, dotViewSun) * 3.0f;

    // halo (linked to same dotViewSun in view space)
    float sunGlow = 1.0f / (1.0f + angleToSun * 500.0f); // 500.0 makes it slightly neater
    sunGlow = pow(sunGlow, 2.0f) * 0.4f; 

    // spreading along horizon
    const float horizonGlow = exp(-skyHeight * 5.0f) * smoothstep(-0.05f, 0.3f, sunHeightWorld) * 0.25f;
    sunGlow += horizonGlow * max(dotViewSun, 0.0f);
    sunGlow *= mix(1.0f, 2.5f, smoothstep(0.2f, -0.1f, sunHeightWorld)); 

    // complete
    const vec3 finalColor = modifiedBaseSkyColor + (sunColor * sunIntensity) + (sunColor * sunGlow);

    // going under horizon
    const vec3 resultColor = mix(modifiedBaseSkyColor, finalColor, smoothstep(-0.18f, 0.02f, sunHeightWorld));

    return SkyColors(resultColor, sunColor);
}

#endif