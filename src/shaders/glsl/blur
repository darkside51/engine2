#ifndef BLUR_HEADER
#define BLUR_HEADER

#include "noise"

const vec2 kPoissonDisk[12] = vec2[](
    vec2(-0.326212, -0.405810),
    vec2(-0.840144, -0.073580),
    vec2(-0.695914,  0.457137),
    vec2(-0.203345,  0.620716),
    vec2( 0.962340, -0.194983),
    vec2( 0.473434, -0.480026),
    vec2( 0.519456,  0.767022),
    vec2( 0.185461, -0.893124),
    vec2( 0.507431,  0.064425),
    vec2( 0.896420,  0.412458),
    vec2(-0.321940, -0.932615),
    vec2(-0.791559, -0.597710)
);

float radialBlur(in sampler2D tex, vec2 uv, int blurRange) {
	int n = 0;
	const vec2 texelSize = 1.0f / vec2(textureSize(tex, 0));
	float result = 0.0f;
	for (int x = -blurRange; x <= blurRange; ++x) {
		for (int y = -blurRange; y <= blurRange; ++y) {
			const vec2 offset = vec2(float(x), float(y)) * texelSize;
			result += texture(tex, uv + offset).r;
			n++;
		}
	}
	return result / float(n);
}

float bilateralAOBlur(
    in sampler2D ssaoTex,
    in sampler2D depthTex,
    in sampler2D normalTex,
    vec2 uv,
    int blurRange
) {
    const vec2 texelSize = 1.0f / vec2(textureSize(ssaoTex, 0));
    
    float centerAO = texture(ssaoTex, uv).r;
    float centerDepth = texture(depthTex, uv).r;
    vec3 centerNormal = normalize(texture(normalTex, uv).rgb * 2.0 - 1.0);

    float totalAO = centerAO;
    float totalWeight = 1.0f;

    // sensitivity thresholds
    const float depthThreshold = 0.05f; // maximum depth difference in meters/units
    const float normalPower = 8.0f;     // normal angle cutoff rigidity

    for (int x = -blurRange; x <= blurRange; ++x) {
        for (int y = -blurRange; y <= blurRange; ++y) {
            if (x == 0 && y == 0) continue;

            vec2 sampleUV = uv + vec2(float(x), float(y)) * texelSize;
            
            float sampleAO = texture(ssaoTex, sampleUV).r;
            float sampleDepth = texture(depthTex, sampleUV).r;
            vec3 sampleNormal = normalize(texture(normalTex, sampleUV).rgb * 2.0 - 1.0);

            // weight by depth difference
            float depthDiff = abs(centerDepth - sampleDepth);
            float depthWeight = max(0.0f, 1.0f - (depthDiff / depthThreshold));
            //float depthWeight = exp(-(depthDiff * depthDiff) / (2.0 * depthThreshold * depthThreshold));

            // weight based on the angle between normals
            float normalWeight = pow(max(0.0f, dot(centerNormal, sampleNormal)), normalPower);

            float weight = depthWeight * normalWeight;

            totalAO += sampleAO * weight;
            totalWeight += weight;
        }
    }

    return totalAO / totalWeight;
}


float bilateralAOBlurPoisson(
    in sampler2D ssaoTex,
    in sampler2D depthTex,
    in sampler2D normalTex,
    vec2 uv,
    float blurRadius // радиус в пикселях (например, 4.0 или 6.0)
) {
    vec2 texSize = vec2(textureSize(ssaoTex, 0));
    vec2 texelSize = 1.0 / texSize;

    float centerAO = texture(ssaoTex, uv).r;
    float centerDepth = texture(depthTex, uv).r;
    vec3 centerNormal = texture(normalTex, uv).rgb * 2.0 - 1.0;

    float totalAO = centerAO;
    float totalWeight = 1.0;

    const float invDepthThreshold = 1.0 / 0.05; // 1.0 / depthThreshold

    // calculate the disk rotation angle for the current pixel
    float angle = interleavedGradientNoise(gl_FragCoord.xy) * 6.2831853; // 2 * PI
    float s = sin(angle);
    float c = cos(angle);
    mat2 rotationMatrix = mat2(c, -s, s, c);

    // scale the radius to the pixel size
    vec2 radiusUV = texelSize * blurRadius;

    for (int i = 0; i < 12; ++i) {
        // rotate the disk point and convert it into a UV offset
        vec2 offset = (rotationMatrix * kPoissonDisk[i]) * radiusUV;
        vec2 sampleUV = uv + offset;

        // early depth-based exit
        float sampleDepth = texture(depthTex, sampleUV).r;
        float depthDiff = abs(centerDepth - sampleDepth);
        float depthWeight = 1.0 - (depthDiff * invDepthThreshold);
        if (depthWeight <= 0.0) continue;

        // early normal-based exit
        vec3 sampleNormal = texture(normalTex, sampleUV).rgb * 2.0 - 1.0;
        float nDot = max(0.0, dot(centerNormal, sampleNormal));
        float n2 = nDot * nDot;
        float n4 = n2 * n2;
        float normalWeight = n4 * n4;
        if (normalWeight <= 0.001) continue;

        float weight = depthWeight * normalWeight;
        float sampleAO = texture(ssaoTex, sampleUV).r;

        totalAO += sampleAO * weight;
        totalWeight += weight;
    }

    return totalAO / totalWeight;
}


#endif