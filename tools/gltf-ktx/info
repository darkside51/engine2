# 1. Скачиваем свежий релиз (пример для Ubuntu x86_64)
wget https://github.com

# 2. Устанавливаем пакет
sudo dpkg -i KTX-Software-4.3.2-Linux-x86_64.deb

# 3. Проверяем, что утилита ktx появилась в системе
ktx --version